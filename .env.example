# Production SDK / worker: use a dedicated, non-owner PostgreSQL role.
DATABASE_URL=postgresql://contextline_app:CHANGE_ME@localhost:5432/contextline
# Migration only: a separate owner connection, never the runtime role.
CONTEXTLINE_MIGRATION_DATABASE_URL=postgresql://contextline_owner:CHANGE_ME@localhost:5432/contextline
CONTEXTLINE_SCHEMA=contextline
# Worker connector configuration; contains no credentials. See docs/deployment.md.
CONTEXTLINE_CONNECTORS_FILE=./connectors.json
REDIS_URL=rediss://default:CHANGE_ME@localhost:6379
# Optional local demo overrides. The demo is unauthenticated; bind loopback only.
PORT=3000
DEMO_DATABASE_PORT=55432
CONTEXTLINE_WORKER_TENANTS=acme-corp,other-corp
